{
  "name": "sous-tests/disposable-consumer",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {"type": "composer", "url": "https://packages.drupal.org/8"},
    {"type": "package", "package": {
      "name": "dropzone/dropzone", "version": "6.3.5", "type": "drupal-library",
      "extra": {"installer-name": "dropzone"},
      "dist": {"url": "https://github.com/enyo/dropzone/releases/download/dropzone%406.3.5/dist.zip", "type": "zip"}
    }}
  ],
  "require": {
    "composer/installers": "^2.3.0",
    "cweagans/composer-patches": "^2.0.0",
    "drupal/core-composer-scaffold": "11.4.11",
    "drupal/core-recipe-unpack": "11.4.11",
    "drupal/core-recommended": "11.4.11",
    "drupal/login_destination": "^2.0.0-beta10@beta",
    "drush/drush": "^13.8.0",
    "oomphinc/composer-installers-extender": "^2.0.1",
    "php": "^8.4"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {"php": "8.4.0"},
    "process-timeout": 600,
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-recipe-unpack": true,
      "oomphinc/composer-installers-extender": true,
      "php-http/discovery": true,
      "symfony/runtime": true
    }
  },
  "extra": {
    "installer-types": ["drupal-recipe", "drupal-library"],
    "installer-paths": {
      "web/core": ["type:drupal-core"],
      "web/modules/contrib/{$name}": ["type:drupal-module"],
      "web/themes/contrib/{$name}": ["type:drupal-theme"],
      "web/recipes/{$name}": ["type:drupal-recipe"],
      "web/libraries/{$name}": ["type:drupal-library"]
    },
    "drupal-scaffold": {"locations": {"web-root": "web/"}},
    "drupal-recipe-unpack": {"ignore": [
      "fourkitchens/sous-admin", "fourkitchens/sous-config-split", "fourkitchens/sous-content-types",
      "fourkitchens/sous-core-layout-builder", "fourkitchens/sous-emulsify", "fourkitchens/sous-formats",
      "fourkitchens/sous-media", "fourkitchens/sous-paragraph-types", "fourkitchens/sous-paragraphs"
    ]},
    "composer-patches": {"patches-file": "patches/patches.json"}
  }
}
