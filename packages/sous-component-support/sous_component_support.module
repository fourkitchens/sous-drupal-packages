<?php

/**
 * @file
 * Provides authoring and rendering behavior for Sous components.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;

const SOUS_COMPONENT_SUPPORT_CUSTOM_TEASER_FIELDS = ['field_heading', 'field_image', 'field_link', 'field_text'];

/**
 * Implements hook_field_widget_complete_WIDGET_TYPE_form_alter().
 */
function sous_component_support_field_widget_complete_inline_entity_form_complex_form_alter(array &$widget, FormStateInterface $form_state, array $context): void {
  $field = $context['items']->getFieldDefinition();
  if ($field->getName() !== 'field_content' || $field->getTargetEntityTypeId() !== 'block_content' || !in_array($field->getTargetBundle(), ['accordion_item', 'tabs_item'], TRUE) || !isset($widget['widget']['actions']['bundle']['#options'])) {
    return;
  }
  $options = &$widget['widget']['actions']['bundle']['#options'];
  $order = array_flip(['text', 'text_with_media', 'image', 'video', 'gallery', 'quote', 'table', 'accordion', 'accordion_item', 'tabs', 'tabs_item', 'content_list', 'embed']);
  $options = array_replace(array_intersect_key($order, $options), $options);
}

/**
 * Implements hook_field_widget_complete_form_alter().
 */
function sous_component_support_field_widget_complete_form_alter(array &$widget, FormStateInterface $form_state, array $context): void {
  $items = $context['items'];
  if ($context['default'] || !sous_component_support_is_list_item($items->getEntity())) {
    return;
  }
  $field_name = $items->getName();
  $item_type = match (TRUE) {
    $field_name === 'field_related_content' => 'existing_content',
    in_array($field_name, SOUS_COMPONENT_SUPPORT_CUSTOM_TEASER_FIELDS, TRUE) => 'custom_content',
    default => NULL,
  };
  if (!$item_type) {
    return;
  }

  $parents = [...$widget['widget']['#field_parents'], 'field_item_type'];
  $name = array_shift($parents);
  foreach ($parents as $parent) {
    $name .= "[$parent]";
  }
  $widget['#states']['visible']['select[name="' . $name . '"]'] = ['value' => $item_type];
}

/**
 * Implements hook_field_group_form_process_alter().
 */
function sous_component_support_field_group_form_process_alter(array &$element, object $group, array $form): void {
  if ($group->bundle !== 'content_list' || !isset($form['field_list_type']['widget']['#parents'])) {
    return;
  }
  $other_type = match ($group->group_name) {
    'group_hand_picked_items' => 'automatic',
    'group_automatic_listing' => 'hand_picked',
    default => NULL,
  };
  if ($other_type === NULL) {
    return;
  }

  $parents = $form['field_list_type']['widget']['#parents'];
  $name = array_shift($parents);
  foreach ($parents as $parent) {
    $name .= "[$parent]";
  }
  // Show both groups on legacy lists until an editor selects a type.
  $element['#states']['visible']['select[name="' . $name . '"]'] = ['!value' => $other_type];
}

/**
 * Implements hook_entity_view().
 */
function sous_component_support_entity_view(array &$build, EntityInterface $entity): void {
  if ($entity instanceof FieldableEntityInterface && $entity->bundle() === 'content_list' && $entity->hasField('field_list_type')) {
    $type = $entity->get('field_list_type')->value;
    if ($type === 'hand_picked') {
      unset($build['field_view']);
    }
    elseif ($type === 'automatic') {
      unset($build['field_content']);
    }
    return;
  }

  if (!sous_component_support_is_list_item($entity)) {
    return;
  }
  $inactive_fields = $entity->get('field_item_type')->value === 'custom_content'
    ? ['field_related_content']
    : SOUS_COMPONENT_SUPPORT_CUSTOM_TEASER_FIELDS;
  foreach ($inactive_fields as $field_name) {
    unset($build[$field_name]);
  }
}

/**
 * Identifies a Content List Item that has its type field installed.
 */
function sous_component_support_is_list_item(EntityInterface $entity): bool {
  return $entity instanceof FieldableEntityInterface
    && in_array($entity->getEntityTypeId(), ['paragraph', 'block_content'], TRUE)
    && $entity->bundle() === 'content_list_item'
    && $entity->hasField('field_item_type');
}
