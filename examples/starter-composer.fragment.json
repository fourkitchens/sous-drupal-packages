{
  "repositories": [
    {
      "type": "composer",
      "url": "https://fourkitchens.github.io/sous-drupal-packages/",
      "canonical": true,
      "only": [
        "fourkitchens/sous-admin", "fourkitchens/sous-config-split", "fourkitchens/sous-content-types",
        "fourkitchens/sous-core-layout-builder", "fourkitchens/sous-emulsify", "fourkitchens/sous-formats",
        "fourkitchens/sous-media", "fourkitchens/sous-paragraph-types", "fourkitchens/sous-paragraphs"
      ]
    },
    { "type": "composer", "url": "https://packages.drupal.org/8" },
    {
      "type": "package",
      "package": {
        "name": "dropzone/dropzone", "version": "6.3.5", "type": "drupal-library",
        "extra": { "installer-name": "dropzone" },
        "dist": { "url": "https://github.com/enyo/dropzone/releases/download/dropzone%406.3.5/dist.zip", "type": "zip" }
      }
    }
  ],
  "require": {
    "fourkitchens/sous-admin": "^2.0",
    "fourkitchens/sous-emulsify": "^2.0",
    "drupal/login_destination": "^2.0.0-beta10@beta"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "drupal-recipe-unpack": {
      "ignore": [
        "fourkitchens/sous-admin", "fourkitchens/sous-config-split", "fourkitchens/sous-content-types",
        "fourkitchens/sous-core-layout-builder", "fourkitchens/sous-emulsify", "fourkitchens/sous-formats",
        "fourkitchens/sous-media", "fourkitchens/sous-paragraph-types", "fourkitchens/sous-paragraphs"
      ]
    }
  }
}
